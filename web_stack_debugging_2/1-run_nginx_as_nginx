#!/usr/bin/env bash
# Runs Nginx as the nginx user and makes it listen on port 8080
pkill -9 apache2
chmod 644 /etc/nginx/nginx.conf
sed -i 's/#user www-data/user nginx/' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /; s/:80 default_server/:8080 default_server/' /etc/nginx/sites-enabled/default
chown -R nginx:nginx /var/log/nginx /var/lib/nginx
su -s /bin/bash nginx -c "service nginx restart"
