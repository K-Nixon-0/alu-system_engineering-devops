#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 using roundrobin
sudo apt-get update
sudo apt-get install -y haproxy
sudo service nginx stop 2>/dev/null
if ! grep -q "web-servers" /etc/haproxy/haproxy.cfg; then
    sudo tee -a /etc/haproxy/haproxy.cfg >/dev/null <<'CONF'

frontend http-in
    bind *:80
    mode http
    default_backend web-servers

backend web-servers
    mode http
    balance roundrobin
    server 7311-web-01 18.134.245.178:80 check
    server 7311-web-02 35.178.19.144:80 check
CONF
fi
if ! grep -q "h1-case-adjust" /etc/haproxy/haproxy.cfg; then
    sudo sed -i '/^global/a\    h1-case-adjust x-served-by X-Served-By' /etc/haproxy/haproxy.cfg
    sudo sed -i '/^frontend http-in/a\    option h1-case-adjust-bogus-client' /etc/haproxy/haproxy.cfg
fi
sudo systemctl enable haproxy 2>/dev/null
sudo service haproxy restart
sleep 2
grep "server " /etc/haproxy/haproxy.cfg
for i in 1 2 3 4; do curl -sI http://localhost | grep -i x-served-by; done
